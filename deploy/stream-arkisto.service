[Unit]
Description=Stream-arkisto (nettiradiotallennin)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=arkisto
Group=arkisto
EnvironmentFile=/etc/stream-arkisto.env
WorkingDirectory=/opt/stream-arkisto
ExecStart=/usr/bin/python3 -m arkisto
Restart=always
RestartSec=5
# Pääprosessi saa SIGTERMin ja sulkee ffmpegit siististi itse
KillMode=mixed
TimeoutStopSec=30
# Suojaukset: ohjelma saa kirjoittaa vain datahakemistoon
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/stream-arkisto -/mnt -/media

[Install]
WantedBy=multi-user.target
