# IceCatch-asetukset. Muutosten jälkeen: sudo systemctl restart icecatch

# Tallenteiden ja tietokannan paikka. Jos käytät erillistä levyä, liitä se esim.
# /mnt/icecatch-hakemistoon (fstab) ja vaihda tähän ICECATCH_DATA_DIR=/mnt/icecatch.
# Polun vaihdon jälkeen aja asennus uudelleen, jotta palvelu saa kirjoitusoikeuden.
ICECATCH_DATA_DIR=/var/lib/icecatch

# Web-käyttöliittymän portti
ICECATCH_PORT=8080

# Käyttäjätunnus ja salasana web-liittymälle. Tyhjä = ei kirjautumista, jolloin kuka
# tahansa samassa verkossa voi käyttää ja poistaa tallenteita. Aseta, jos verkko ei ole oma.
ICECATCH_USER=
ICECATCH_PASS=

# Valmiiden tiedostojen muoto (mp3 tai opus) ja bittinopeus
ICECATCH_FORMAT=mp3
ICECATCH_BITRATE=160k

# Automaattinen tallennus: uuden striimin oletusenimmäispituus (min), kuinka usein
# striimit tarkistetaan (s) ja kuinka pitkä katko päättää lähetyksen (s)
ICECATCH_MAX_DURATION_MIN=240
ICECATCH_AUTO_POLL_S=15
ICECATCH_AUTO_GRACE_S=180

# Levytila: näin monta megatavua jätetään aina vapaaksi. Jos tila ei riitä, tallennus jää
# tekemättä tai pysähtyy, ja siitä näkyy virhe. Tallenteita ei poisteta tilan vuoksi.
ICECATCH_MIN_FREE_MB=1024

# Tätä lyhyempi (s) käsitelty tallenne merkitään tyhjäksi
ICECATCH_EMPTY_THRESHOLD=30
