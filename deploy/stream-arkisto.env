# Stream-arkiston asetukset. Muutosten jälkeen: sudo systemctl restart stream-arkisto

# Tallenteiden ja tietokannan paikka. Jos käytät USB-levyä, liitä se esim.
# /mnt/arkisto -hakemistoon (fstab) ja vaihda tähän ARKISTO_DATA_DIR=/mnt/arkisto
ARKISTO_DATA_DIR=/var/lib/stream-arkisto

# Web-käyttöliittymän portti
ARKISTO_PORT=8080

# Salasana web-liittymälle (tyhjä = ei kirjautumista, sopii kotiverkkoon)
ARKISTO_USER=
ARKISTO_PASS=

# Lopullisten tiedostojen muoto: mp3 tai opus, ja bittinopeus
ARKISTO_FORMAT=mp3
ARKISTO_BITRATE=160k

# Alle tämän pituinen (s) käsitelty tallenne merkitään tyhjäksi
ARKISTO_EMPTY_THRESHOLD=30
